# Dependencies and build output (made by `npm ci` and `npm run build`)
node_modules/
dist/

# Large downloads and third-party tools (made by `npm run setup:voice` or bundled in releases)
models/
tools/
!tools/
tools/*
!tools/quickshare/
tools/quickshare/python/*
!tools/quickshare/python/python313._pth

# Release packages
*.zip
*.tgz
release/
_to_delete/
_update/

# Personal / machine-local files — never commit these.
# Charles keeps settings, chat history, memory and encrypted keys in %APPDATA%\Charles,
# not in this folder. The files below only matter if someone copies them here by mistake.
Charles-creator.json
charles-install.json
personal.json
companion.json
charles-history.json
preferences.json
*.enc.json
*.key
*.pem
.env
.env.*

# Logs and OS / editor clutter
*.log
npm-debug.log*
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Python cache
__pycache__/
*.pyc

# Personal guide for publishing to GitHub; kept only in the local copy
docs/GITHUB.md
docs/VERIFICATION-v0.4.4.md

# Local visual regression captures
.qa/

# Agent scratch files and local rollback copies
.mimocode/
alpha-backups/
